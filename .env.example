# --- database ---------------------------------------------------------------
POSTGRES_USER=stockmind
POSTGRES_PASSWORD=stockmind
POSTGRES_DB=stockmind

# --- backend ----------------------------------------------------------------
# Postgres is the application database.
DATABASE_URL=postgresql+psycopg://stockmind:stockmind@localhost:5432/stockmind
ENVIRONMENT=dev
SECRET_KEY=stockmind-demo-secret-change-me
CORS_ORIGINS=http://localhost:3000
SQL_ECHO=false

# Optional LLM narration. When empty, the deterministic explainer is used and the
# application stays fully functional.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- policy overrides (optional) -------------------------------------------
# Any app.config.Policy field can be overridden with STOCKMIND_<FIELD>, e.g.
# STOCKMIND_AGING_DAYS=60
# STOCKMIND_NO_SALE_DAYS=30
# STOCKMIND_EXCESS_STOCK_MULTIPLIER=2.5
# STOCKMIND_MAX_AUTONOMOUS_DISCOUNT=0.20

# --- frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
